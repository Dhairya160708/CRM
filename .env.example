# Database
DATABASE_URL="postgresql://user:password@localhost:5432/medtrade_crm"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic (email parsing)
ANTHROPIC_API_KEY="sk-ant-..."

# Gmail OAuth (optional)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""

# Encryption key for sensitive fields (32 bytes hex = 64 hex chars)
ENCRYPTION_KEY="your-64-character-hex-string-here-000000000000000000000000000000"

# AWS S3 (optional, for document storage)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"
